<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatform>windows10.0.17763.0</SupportedOSPlatform>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>WFAC010</NoWarn>

    <!--
      程序集元数据。注意 <Copyright> 里同时保留了上游 MIT 项目的版权声明：
      本项目基于 https://github.com/twibster/ScreenSound（MIT，Copyright © 2026 Omar Omran）
      修改而来，按 MIT 要求保留其版权与许可声明，详见仓库根目录
      LICENSE-ScreenSound-MIT.txt 与 README.md。
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>VideoTurner</Product>
    <AssemblyTitle>VideoTurner</AssemblyTitle>
    <Authors>VideoTurner</Authors>
    <Company>VideoTurner</Company>
    <Description>窗口在哪台显示器，声音就从哪台显示器的音响出声。基于 ScreenSound（MIT）的中文版多显示器音频路由工具。</Description>
    <Copyright>Copyright (c) 2026 VideoTurner. 包含 Copyright (c) 2026 Omar Omran 的 MIT 许可代码（ScreenSound）。</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="WPF-UI" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      app.ico 已经通过上面的 <ApplicationIcon> 嵌进 exe 的 Win32 图标资源；
      这里再作为 WPF 资源打包一份，供托盘图标按 DPI 取合适尺寸的帧
      （见 Views/MainWindow.xaml.cs > SetupTrayIcon）。
      app-icon.png 是 256×256 位图，供关于页显示（WPF 的 BitmapImage 取 ICO 只会取第一帧，
      直接指向 app.ico 会得到被放大的 16×16 模糊图）。
    -->
    <Resource Include="app.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MIT 许可要求随二进制一起保留版权与许可声明，所以把上游的许可证原文
      复制到输出目录（会和 exe 放在一起）。
    -->
    <None Include="..\..\LICENSE-ScreenSound-MIT.txt"
          Link="LICENSE-ScreenSound-MIT.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
