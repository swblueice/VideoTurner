<?xml version="1.0" encoding="utf-8"?>
<!--
  开源版 NuGet 配置：走官方 nuget.org。
  若处在离线 / 受限网络（例如 schannel 报 SEC_E_NO_CREDENTIALS），
  可改用离线源配置文件 NuGet.offline.config（该文件不入库，见 .gitignore
  与 README「从源码构建」一节）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
